# Copy to .env and fill in. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...
# Any OpenRouter chat model id. Cheap + strong defaults that handle JSON well:
#   google/gemini-2.5-flash   openai/gpt-4o-mini   anthropic/claude-haiku-4.5
OPENROUTER_MODEL=google/gemini-2.5-flash
# Local embedding model (downloaded once by sentence-transformers)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Passages returned with every answer
TOP_K=6
