# Copy to .env and fill in at least one provider key. Everything below is a free tier.
#
# Providers are tried in PROVIDER_ORDER (default codecraft,groq,gemini,openrouter); a provider
# without a key is skipped. Within a provider, models are tried in order and a dead or
# rate-limited model is parked for a while. GET /health shows the chain and the quota headers.

# CodeCraft API: https://codecraftapi.com (paid gateway, OpenAI-compatible, 31 models)
# CODECRAFT_API_KEY=cc_...
# CODECRAFT_MODELS=deepseek-v4-flash-0731,gpt-5.6-luna,gemini-3.7-flash

# OpenRouter: https://openrouter.ai/keys
# A free-tier key allows 50 free-model requests per day; with $10 of credits on the account it
# is 1,000 per day, still using only ":free" models. Avoid the "openrouter/free" router: it can
# hand a question to a safety classifier. Free models are withdrawn without notice, so several
# fallbacks are configured in app/config.py; override with OPENROUTER_FALLBACKS (comma list).
OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# OPENROUTER_FALLBACKS=poolside/laguna-s-2.1:free,google/gemma-4-31b-it:free

# Groq: https://console.groq.com/keys  (free, fast, generous daily limits)  <- recommended
# GROQ_API_KEY=gsk_...
# GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b

# Google AI Studio: https://aistudio.google.com/apikey  (free tier: ~10 requests/min per project)
# GEMINI_API_KEY=AIza...
# Several keys are supported (GEMINI_API_KEYS=a,b,c or GEMINI_API_KEY1=..., GEMINI_API_KEY2=...)
# and batch work rotates across them. Only for keys that are legitimately separate: creating
# several free projects to multiply the free quota violates Google's terms and gets the
# projects suspended (it happened during this project). Same for the other providers' *_API_KEYS.
# GEMINI_MODELS=gemini-3.5-flash-lite,gemini-2.5-flash,gemini-flash-lite-latest

# PROVIDER_ORDER=groq,gemini,openrouter

# Local embedding model (downloaded once by sentence-transformers, ~130 MB)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Passages returned with every answer
TOP_K=6

# Best-passage cosine below which the corpus is treated as silent without calling the LLM
MIN_SIMILARITY=0.45

# Second LLM call that checks an "answered" against only its cited passages (1 = on)
VERIFY_ANSWERS=1
