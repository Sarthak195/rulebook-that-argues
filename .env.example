# Copy to .env and fill in. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Free OpenRouter models come and go (minimax/minimax-m3:free was withdrawn mid-project), so the
# client tries OPENROUTER_MODEL first and then OPENROUTER_FALLBACKS in order. Leave both unset to
# use the defaults in app/config.py. Compare candidates with scripts/probe_models.py.
# Avoid the "openrouter/free" router: it can hand a question to a safety classifier.
# OPENROUTER_MODEL=google/gemma-4-31b-it:free
# OPENROUTER_FALLBACKS=nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-26b-a4b-it:free

# Local embedding model (downloaded once by sentence-transformers, ~130 MB)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Passages returned with every answer
TOP_K=6

# Best-passage cosine below which the corpus is treated as silent without calling the LLM
MIN_SIMILARITY=0.45
